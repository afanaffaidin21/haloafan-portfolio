# Database
DATABASE_URI=file:./payload.db
# Required for `npm run build` / `npm start` (NODE_ENV=production); optional for dev and test.
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 uploads. Leave any of these empty to store uploads in ./media.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Public custom domain of the bucket, e.g. https://media.example.com (no trailing slash).
R2_PUBLIC_URL=
